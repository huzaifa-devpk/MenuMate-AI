# MenuMate AI Environment Configuration

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Database Path (SQLite file path)
DATABASE_PATH=./data/menumate.sqlite

# Gemma AI Configuration
# Supported providers: "google" (Google AI Studio), "groq" (Groq Cloud), "openai_compatible" (Ollama, Together, OpenRouter)
GEMMA_PROVIDER=google

# Gemma API Key (Get free key from Google AI Studio at https://aistudio.google.com/ or Groq at https://console.groq.com/)
GEMMA_API_KEY=your_gemma_api_key_here

# Gemma Model Identifier
# For Google AI Studio: gemma-2-9b-it (or gemma-2-27b-it)
# For Groq: gemma2-9b-it
GEMMA_MODEL=gemma-2-9b-it

# Optional Custom Base URL (leave empty for default official provider endpoints)
# Google AI Studio default: https://generativelanguage.googleapis.com
# Groq default: https://api.groq.com/openai/v1
# Ollama example: http://localhost:11434/v1
GEMMA_API_BASE_URL=

# Application Base URL (Used for generating QR codes and public menu share links)
# For local development: http://localhost:5173
# For production: https://your-domain.onrender.com
APP_BASE_URL=http://localhost:5173
