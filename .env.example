# ---------------------------------------------------------------------------
# MenuMate AI — environment configuration
# Copy this file to `.env` in the project root and fill in the values.
# Never commit a real `.env` file or a real API key.
# ---------------------------------------------------------------------------

# Port the Express server listens on. Render sets PORT automatically.
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Path to the SQLite database file. The directory is created if missing.
# On Render, point this at a persistent disk, e.g. /var/data/menumate.sqlite
DATABASE_PATH=./data/menumate.sqlite

# Public base URL of the app. Used to build public menu links and QR codes.
# Local example:  http://localhost:5173 (Vite dev server) or http://localhost:3001 (production build)
# Render example: https://your-service.onrender.com
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Gemma (open-weight model) via a hosted inference provider
# ---------------------------------------------------------------------------
# Default provider is Google's Gemini API, which hosts Gemma 4 open models.
# Create a key in Google AI Studio: https://aistudio.google.com/app/apikey
# The key is only ever read on the server. Leave empty to run without AI
# features (the app, demo menu, PDF and QR code still work).
GEMMA_API_KEY=

# Provider: "google" (Gemini API hosting Gemma) or "openai-compatible"
# (any OpenAI-style /chat/completions endpoint serving a Gemma model,
#  e.g. Ollama, Groq, Together, vLLM).
GEMMA_PROVIDER=google

# Model identifier. Verified Gemma models on the Gemini API (Oct 2026):
#   gemma-4-31b-it        (dense, highest quality)
#   gemma-4-26b-a4b-it    (mixture-of-experts, faster)
GEMMA_MODEL=gemma-4-31b-it

# Base URL of the provider API.
#   google:             https://generativelanguage.googleapis.com/v1beta
#   openai-compatible:  e.g. http://localhost:11434/v1 (Ollama) or https://api.groq.com/openai/v1
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemma 4 "thinking" level on the Gemini API: minimal (fast, default) or high.
GEMMA_THINKING_LEVEL=minimal

# Request timeout for AI calls in milliseconds.
GEMMA_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Max AI requests per IP per 15 minutes.
AI_RATE_LIMIT_PER_15_MIN=30
